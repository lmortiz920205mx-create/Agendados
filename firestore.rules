rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isOperator() {
      return signedIn() && request.auth.token.role == 'operador';
    }

    function isStaff() {
      return isAdmin() || isOperator();
    }

    match /servicios/{serviceId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /tokens/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if isStaff() && request.auth.uid == userId;
    }

    match /usuarios/{userId} {
      allow read: if isStaff() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
